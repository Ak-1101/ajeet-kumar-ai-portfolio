# Supabase Public Configuration (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used ONLY in secure server actions/routes, NEVER exposed in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Initial Admin Credentials (used for initial setup & fallback admin access)
ADMIN_EMAIL=ajeetkumar.ak1101@gmail.com
ADMIN_INITIAL_PASSWORD=YourSecurePassword123!

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
